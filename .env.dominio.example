# Dominio público (copiar a .env.dominio no VPS; perm 600; NUNCA committear)
# Xerar segredo: openssl rand -base64 32

ROOT_HOST=pistaaberta.com
APP_HOST=demo.pistaaberta.com
CERT_HOST=cert.pistaaberta.com
APP_BASE_URL=https://demo.pistaaberta.com
API_BASE_URL=https://demo.pistaaberta.com

SAML_SP_ENTITY_ID=https://demo.pistaaberta.com/auth/saml/metadata
SAML_CALLBACK_URL=https://demo.pistaaberta.com/auth/saml/acs
SAML_IDP_ENTITY_ID=https://demo.pistaaberta.com/auth/saml/mock-idp
SAML_IDP_SSO_URL=https://demo.pistaaberta.com/auth/saml/mock-idp

# Certificado dixital — un só stack (vps + dominio). A API recibe estes via overlay.
CERT_LOGIN_ENABLED=1
CERT_ORIGIN=https://cert.pistaaberta.com
# openssl rand -base64 32  (≥32 chars); NUNCA no git
CERT_GATEWAY_SECRET=

# Rede proxy do operador (Paso 1): 10.0.1.0/24
PROXY_SUBNET=10.0.1.0/24
TRUST_PROXY=1

# Demo pública sen semente, contas de Cl@ve simulado desde ficheiro e foto persistente
PA_DEMO=1
PA_DEMO_EMPTY=1
DEMO_USERS_HOST_FILE=./deploy/demo/demo-users.json
DEMO_USERS_FILE=/config/demo-users.json
DEMO_SETUP_HOST_FILE=./deploy/demo/demo-setup.json
DEMO_SETUP_FILE=/config/demo-setup.json
DEMO_SNAPSHOT_PATH=/data/demo-snapshot
# Despois de gardar a foto boa, pon DEMO_SNAPSHOT_LOCKED=1 e reinicia
DEMO_SNAPSHOT_LOCKED=0
# Reseteo nocturno 04:00 Europe/Madrid (só se hai foto). 0 = desactivado
DEMO_NIGHTLY_RESET=1
DEMO_DATA_VOLUME=pista-aberta_appdata

# Correo para avisos de Let's Encrypt (certbot cert.*)
LE_EMAIL=
# URL pública do repositorio (web + landing). Baleiro = sen ligazóns de código no pé.
VITE_REPO_URL=
