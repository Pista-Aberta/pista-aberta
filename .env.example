# Pista Aberta — variables de proba (copiar a .env)

NODE_ENV=development
# A demo e a súa semente requiren activación explícita, tamén en local.
PA_DEMO=1
VITE_PA_DEMO=1

# Persistencia:
# - docker compose: postgres://pista:pista@postgres:5432/pista_aberta
# - local sen Docker: deixar baleiro → PGlite en .data/pglite
# - Postgres no host: postgres://pista:pista@127.0.0.1:5432/pista_aberta
DATABASE_URL=

# API
API_HOST=0.0.0.0
API_PORT=3001
# Activar TRUST_PROXY=1 só cando a API está exclusivamente detrás de nginx/Caddy propio.
TRUST_PROXY=0
SESSION_SECRET=change-me-in-production
APP_BASE_URL=http://localhost:3000
# Dev local: mesmo orixe que a web (proxy Vite /auth) para SAML form-action.
# En produción/demo: URL pública da API (ou gateway).
API_BASE_URL=http://localhost:3000
# Landing pública (CORS só GET /api/c/:slug/partidos-abertos, sen credentials).
LANDING_ORIGIN=https://pistaaberta.com

# SMTP (Mailpit en docker compose; sen SMTP os códigos OTP van aos logs)
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM=noreply@pistaaberta.local

# SAML 2.0 SP + IdP mock asinado (demo — NON é Cl@ve real)
# Se omites estes, derívanse de API_BASE_URL.
# SAML_SP_ENTITY_ID=http://localhost:3000/auth/saml/metadata
# SAML_IDP_ENTITY_ID=http://localhost:3000/auth/saml/mock-idp
# SAML_IDP_SSO_URL=http://localhost:3000/auth/saml/mock-idp
# SAML_CALLBACK_URL=http://localhost:3000/auth/saml/acs
# SAML_CERTS_DIR=apps/api/certs

# Certificado dixital (mTLS). Off por defecto; activar no overlay dominio.
CERT_LOGIN_ENABLED=0
# CERT_HOST=cert.pistaaberta.com
# CERT_ORIGIN=https://cert.pistaaberta.com
# CERT_GATEWAY_SECRET=   # openssl rand -base64 32

# Web
VITE_API_URL=
VITE_DEFAULT_LOCALE=gl
# URL pública do repositorio (web + landing). Baleiro = sen ligazóns de código no pé.
VITE_REPO_URL=
