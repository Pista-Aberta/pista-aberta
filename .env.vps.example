# Demo VPS — copiar a .env.vps no servidor (perm 600; non committear secrets reais)
# Xerar: openssl rand -hex 32
POSTGRES_PASSWORD=
SESSION_SECRET=

# Demo VPS: PA_DEMO=1 + NODE_ENV=demo (rol SAML só seed/BD; validateInResponseTo=never)
# Prod real: NODE_ENV=production, SAML_VALIDATE_IN_RESPONSE_TO=always, sen PA_DEMO,
#            SESSION_SECRET forte, certificados SAML non-demo (ou SAML_ALLOW_DEMO_CERTS=1 só lab)
PA_DEMO=1
NODE_ENV=demo
SAML_VALIDATE_IN_RESPONSE_TO=never
# Staff/admin: en produción o OTP non eleva (AUTH_ELEVATED_SAML_ONLY implícito).
# AUTH_ELEVATED_SAML_ONLY=1
COOKIE_SECURE=1
TRUST_PROXY=1

# URL pública da demo (substituír polo dominio real)
APP_BASE_URL=https://demo.example.org
API_BASE_URL=https://demo.example.org

SAML_SP_ENTITY_ID=https://demo.example.org/auth/saml/metadata
SAML_IDP_ENTITY_ID=https://demo.example.org/auth/saml/mock-idp
SAML_IDP_SSO_URL=https://demo.example.org/auth/saml/mock-idp
SAML_CALLBACK_URL=https://demo.example.org/auth/saml/acs

# Certificado dixital (obrigatorio co overlay docker-compose.dominio.yml).
# Os valores reais viven en .env.dominio; aquí só se o stack VPS vai só.
# CERT_LOGIN_ENABLED=1
# CERT_HOST=cert.pistaaberta.com
# CERT_ORIGIN=https://cert.pistaaberta.com
# CERT_GATEWAY_SECRET=   # openssl rand -base64 32 (≥32); NUNCA no git
# URL pública do repositorio (web + landing). Baleiro = sen ligazóns de código no pé.
VITE_REPO_URL=
